# Always normalize to LF in the repo
* text=auto eol=lf

# Force LF for shell scripts and Docker files specifically
*.sh           text eol=lf
bankcore       text eol=lf
Dockerfile     text eol=lf
docker-compose.yml text eol=lf
Makefile       text eol=lf
*.cpp          text eol=lf
*.h            text eol=lf
*.sql          text eol=lf
*.yml          text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.pdf  binary
